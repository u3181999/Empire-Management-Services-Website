{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 17 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.empiremanagementservices.com.au"
        }
      ],
      "destination": "https://empiremanagementservices.com.au/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.empiremanagementservices.com.au"
        }
      ],
      "destination": "https://empiremanagementservices.com.au/:path*",
      "permanent": true
    }
  ]
}
