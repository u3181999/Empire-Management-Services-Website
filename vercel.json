{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 17 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.empirecleaning.com.au" }],
      "destination": "https://empirecleaning.com.au/:path*",
      "permanent": true
    }
  ]
}
