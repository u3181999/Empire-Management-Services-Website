# =====================================================
# Empire Management Services — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ---
# Database (PostgreSQL)
# Recommended: https://neon.tech (free tier)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ---
DATABASE_URL="postgresql://user:password@host:5432/empire?sslmode=require"

# ---
# NextAuth (Authentication)
# Generate secret: openssl rand -base64 32
# ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-char-random-secret-here"

# ---
# Resend (Transactional Email)
# Get API key from https://resend.com
# ---
RESEND_API_KEY="re_..."

# ---
# Admin Email (receives booking/contact notifications)
# ---
ADMIN_EMAIL="admin@empirecleaning.com.au"

# ---
# Seed Admin Password (used by prisma db seed)
# Change this before running seed in production
# ---
SEED_ADMIN_PASSWORD="ChangeMe123!"
