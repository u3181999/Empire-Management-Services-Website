# =====================================================
# Empire Management Services — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ---
# Database (PostgreSQL)
# Recommended: https://neon.tech (free tier)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ---
DATABASE_URL="postgresql://user:password@host:5432/empire?sslmode=require"

# ---
# NextAuth (Authentication)
# Generate secret: openssl rand -base64 32
# ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-char-random-secret-here"

# ---
# Resend (Transactional Email)
# Get API key from https://resend.com
# ---
RESEND_API_KEY="re_..."

# ---
# Admin Email (receives booking/contact notifications)
# ---
ADMIN_EMAIL="admin@empirecleaning.com.au"

# ---
# Admin sign-in (used by prisma db seed and npm run admin:set-password)
# ADMIN_LOGIN_EMAIL is the private email you sign in to /admin with. Keep it off the website and out of the code.
# SEED_ADMIN_PASSWORD must be a long unique password (12+ characters); there is no default.
# ---
ADMIN_LOGIN_EMAIL="your-private-admin-email@example.com"
SEED_ADMIN_PASSWORD="choose-a-long-unique-password"
